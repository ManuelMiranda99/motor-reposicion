# Copia este archivo a .env (ya está en .gitignore) y complétalo. No subas tokens a git.

# UID del usuario del host (evita archivos de root en el repo). En Linux/macOS:  id -u
AIRFLOW_UID=50000

# Bandeja de entrada (solo lectura dentro del contenedor). Para operar otra bandeja, por ejemplo
# la del periodo no publicado, apunta aquí a su carpeta (con una subcarpeta por fecha de entrega).
BANDEJA_PATH=./bandeja_sim

# Periodo que operan los DAGs (primer y último corte). Vacío = valores de config/operacion.yaml
# (2017-01-02 → 2017-08-14). Los DAGs corren con catchup entre estas fechas.
REPOSICION_INICIO=2017-01-02
REPOSICION_FIN=2017-08-14

# Token de DagsHub para `dvc push` de los datos (opcional; sin él no se hace push, solo un warning).
DAGSHUB_TOKEN=

# Token de GitHub con permiso de escritura en el repo, para publicar la rama `publicaciones`
# (opcional; sin él, el commit queda solo local y se emite un warning).
GITHUB_TOKEN=

# Commit del código que queda en los manifiestos (opcional; vacío = git rev-parse HEAD).
# REPOSICION_GIT_COMMIT=

# Usuario y contraseña de la UI de Airflow (por defecto airflow / airflow).
# _AIRFLOW_WWW_USER_USERNAME=airflow
# _AIRFLOW_WWW_USER_PASSWORD=airflow
